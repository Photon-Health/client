{
  "name": "patient",
  "root": "apps/patient",
  "sourceRoot": "apps/patient/src",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "npx graphql-codegen"
      }
    },
    "codegen:watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "npx graphql-codegen --watch"
      }
    },
    "codegen:tau": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "GQL_SCHEMA_URL='http://patient-api.tau.health:8080' npx graphql-codegen"
      }
    },
    "codegen:tau:watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "GQL_SCHEMA_URL='http://patient-api.tau.health:8080' npx graphql-codegen --watch"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "env-cmd -f .env.boson vite --mode boson"
      },
      "dependsOn": ["^build", "codegen"]
    },
    "start:tau": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "env-cmd -f .env.tau vite --mode tau"
      },
      "dependsOn": ["^build", "codegen:tau"]
    },
    "build:boson": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "env-cmd -f .env.boson vite build --mode boson"
      },
      "outputs": ["{projectRoot}/../../dist/apps/patient"],
      "dependsOn": ["^build", "codegen"]
    },
    "build:neutron": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "env-cmd -f .env.neutron vite build --mode neutron"
      },
      "outputs": ["{projectRoot}/../../dist/apps/patient"],
      "dependsOn": ["^build", "codegen"]
    },
    "build:photon": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "env-cmd -f .env.photon vite build --mode photon"
      },
      "outputs": ["{projectRoot}/../../dist/apps/patient"],
      "dependsOn": ["^build", "codegen"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "vitest run"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "npx eslint . --ext .tsx,.ts --quiet"
      },
      "dependsOn": ["codegen"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "npx eslint . --ext .tsx,.ts --fix && npx prettier --write src/**/*.{ts,tsx}"
      },
      "dependsOn": ["codegen"]
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/patient",
        "command": "npx tsc --noEmit"
      },
      "dependsOn": ["codegen"]
    }
  }
}
