{
  "name": "sdk",
  "root": "packages/sdk",
  "sourceRoot": "packages/sdk/src",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "codegen:clinical-api": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "VITE_ENV_NAME=boson npx graphql-codegen --config codegen.clinical-api.ts"
      }
    },
    "codegen:clinical-api:tau": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "VITE_ENV_NAME=tau npx graphql-codegen --config codegen.clinical-api.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "commands": [
          "rimraf dist",
          "tsc --emitDeclarationOnly --outDir dist",
          "vite build",
          "cp src/types.ts dist/types.ts",
          "cp src/graphql/clinical-api/gql/graphql.ts dist/graphql/clinical-api/gql/graphql.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["codegen:clinical-api"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "vite --port 3000"
      },
      "dependsOn": ["codegen:clinical-api"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "npx eslint . --quiet"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "npx eslint src/**/*.ts --fix && npx prettier --write src/**/*.ts"
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "npx tsc --noEmit"
      },
      "dependsOn": ["codegen:clinical-api"]
    }
  }
}
