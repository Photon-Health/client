{
  "name": "components",
  "root": "packages/components",
  "sourceRoot": "packages/components/src",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/components",
        "command": "vite build && npx tailwindcss -i ./src/index.css -o ./dist/style.css"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/components",
        "commands": [
          "npx tailwindcss -i ./src/index.css -o ./src/style.css",
          "vitest run",
          "rimraf ./src/style.css"
        ],
        "parallel": false
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/components",
        "command": "storybook build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/components",
        "command": "npx eslint . --ext .tsx,.ts --quiet"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/components",
        "command": "npx eslint src/**/*.ts --fix && npx prettier --write src/**/*.ts"
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/components",
        "command": "npx tsc --noEmit"
      }
    }
  }
}
