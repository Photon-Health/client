{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@photonhealth/components": ["../../packages/components/src/index.ts"],
      "@photonhealth/components/*": ["../../packages/components/src/*"]
    }
  },
  "include": ["src/**/*", "types.d.ts"],
  "exclude": ["node_modules"]
}
